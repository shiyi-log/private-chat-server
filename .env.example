# Local development only. Generate a distinct random value for every password,
# then copy this file to .env. Compose refuses to start while required values are empty.
TEAMGRAM_HOST_BIND_ADDRESS=127.0.0.1

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=teamgram
MYSQL_USER=teamgram
MYSQL_PASSWORD=

# ---------- MinIO ----------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://127.0.0.1:13001
